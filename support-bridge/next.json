{
  "version": 1,
  "id": "ttb-news-runner-idle-20261112-1230",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Check whether editorial launcher is idle before guarded install",
  "steps": [
    {
      "kind": "powershell",
      "name": "runner-idle",
      "script": "$a=@(Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { [string]$_.CommandLine -match 'Ejecutar[.]js|TT-Editorial-Guard[.]js' } | ForEach-Object { $_.ProcessId })\nWrite-Output ('TTRESULT:'+(@{state='ok';pids=($a -join ',')}|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
