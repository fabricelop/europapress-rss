{
  "version": 1,
  "id": "ttb-editorial-active-pids-20261112-1130",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Read only active editorial runner identity and start time",
  "steps": [
    {
      "kind": "powershell",
      "name": "active-runner-identities",
      "script": "$o=@{state='ok';runners=@()}\nforeach($p in @(3892,17708)){\n $q=Get-CimInstance Win32_Process -Filter \"ProcessId=$p\" -ErrorAction SilentlyContinue\n if($q){$o.runners+=@{pid=$p;created=[string]$q.CreationDate;command=([string]$q.CommandLine).Substring(0,[Math]::Min(220,([string]$q.CommandLine).Length))}}\n}\nWrite-Output ('TTRESULT:'+($o|ConvertTo-Json -Compress -Depth 4))",
      "timeout_seconds": 25
    },
    {
      "kind": "builtin",
      "name": "listener-summary",
      "timeout_seconds": 25
    }
  ]
}
