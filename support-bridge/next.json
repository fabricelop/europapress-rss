      "script": "$f='C:\\TTiTTulares\\ttittulares-mobile-trigger.log'\n$l=if(Test-Path $f){[string](Get-Content $f -Tail 1)}else{'missing'}\nWrite-Output ('TTRESULT:'+(@{state='ok';last=$l.Substring(0,[Math]::Min(300,$l.Length))}|ConvertTo-Json -Compress))",
