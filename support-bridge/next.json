  "description": "Read latest news task and listener status",
  "steps": [
    {
      "kind": "powershell",
      "name": "news-task-state",
      "script": "$f='C:\\TTiTTulares\\ttittulares-mobile-trigger.log'\n$l=[string](Get-Content $f -Tail 1)\n$t=Get-ScheduledTask -TaskName 'TTiTTulares Local'\nWrite-Output ('TTRESULT:'+(@{state='ok';last=$l.Substring(0,[Math]::Min(500,$l.Length));task=[string]$t.State}|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
