      "script": "try{$p='C:\\TTiTTulares\\image-approval-receipts\\tr-img-auto-5e5af80baed0-r0-a1-1794458225789.json';$j=Get-Content $p -Raw|ConvertFrom-Json;$o=@{project=$j.project;state=$j.state;receivedAt=$j.receivedAt;validId=([string]$j.id).Length -gt 0;hasSha=([string]$j.rasterSHA256).Length -eq 64};Write-Output ('TTRESULT:'+($o|ConvertTo-Json -Compress))}catch{Write-Output ('TTRESULT:'+(@{error=$_.Exception.Message}|ConvertTo-Json -Compress))}",
