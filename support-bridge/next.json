{
  "version": 1,
  "id": "ttb-news-draftbackup-result-20261112-1340",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Read-only result flags for one news draft preservation attempt",
  "steps": [
    {
      "kind": "powershell",
      "name": "draftbackup-result",
      "script": "$l=@(Get-Content 'C:\\TTiTTulares\\ttittulares-mobile-trigger.log' -Tail 500)\n$id='tt-draftbackup-1794482993257'\n$o=@{state='pending';seen=@($l|Where-Object{$_ -match $id}).Count;backup=[bool](@($l|Where-Object{$_ -match 'RESTORED_DRAFT_BACKED_UP_LOCAL'}).Count);cleared=[bool](@($l|Where-Object{$_ -match 'RESTORED_DRAFT_CLEARED_BOT_TAB'}).Count)}\nif(@($l|Where-Object{$_ -match ('LAUNCH CONFIRMED.*'+$id)}).Count){$o.state='confirmed'}\nif(@($l|Where-Object{$_ -match ('LAUNCH FAILED.*'+$id)}).Count){$o.state='failed'}\nWrite-Output ('TTRESULT:'+($o|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
