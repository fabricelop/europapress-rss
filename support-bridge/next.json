{
  "version": 1,
  "id": "ttb-news-active-runner-20261112-1212",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Read active runner command labels only",
  "steps": [
    {
      "kind": "powershell",
      "name": "active-runner-labels",
      "script": "$a=@(Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { [string]$_.CommandLine -match 'Ejecutar[.]js|TT-Editorial-Guard[.]js' } | ForEach-Object { \"$($_.ProcessId):$([string]$_.CommandLine -replace '.*TTiTTulares[\\\\/]','')\" })\nWrite-Output ('TTRESULT:'+(@{state='ok';runners=($a -join ';')}|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
