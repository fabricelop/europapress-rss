{
  "version": 1,
  "id": "ttb-news-runner-51120-20261112-1232",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Identify one active editorial runner without stopping it",
  "steps": [
    {
      "kind": "powershell",
      "name": "runner-identity",
      "script": "$p=Get-CimInstance Win32_Process -Filter 'ProcessId=51120'\n$v=if($p){@{state='ok';cmd=([string]$p.CommandLine).Substring(0,[Math]::Min(220,([string]$p.CommandLine).Length));created=[string]$p.CreationDate}}else{@{state='gone'}}\nWrite-Output ('TTRESULT:'+($v|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
