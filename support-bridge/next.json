{
  "version": 1,
  "id": "ttb-news-timeout-ledger-20261112-1225",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Read exact timed-out editorial send ledger and last stdout",
  "steps": [
    {
      "kind": "powershell",
      "name": "timeout-ledger",
      "script": "$id='tt-urgent-1794480233639'\n$dir='C:\\TTiTTulares\\TT-Editorial-Rescue\\sent'\n$f=Get-ChildItem $dir -Filter \"*$id*.json\" -ErrorAction SilentlyContinue | Select-Object -First 1\n$status=if($f){[string]((Get-Content $f.FullName -Raw | ConvertFrom-Json).status)}else{'no_ledger'}\n$log='C:\\TTiTTulares\\ttittulares-launch-'+$id+'.log'\n$last=if(Test-Path $log){[string](Get-Content $log -Tail 1)}else{'no_stdout'}\nWrite-Output ('TTRESULT:'+(@{state='ok';ledger=$status;last=$last.Substring(0,[Math]::Min(500,$last.Length))}|ConvertTo-Json -Compress))",
      "timeout_seconds": 25
    }
  ]
}
