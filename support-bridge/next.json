{
  "version": 1,
  "id": "ttb-v2-radar15-diagnose-20261114-01",
  "project": "TTActualidad",
  "expires_at": "2026-11-15T23:00:00Z",
  "description": "Diagnóstico de solo lectura del programador Windows de Radar V2 cada 15 min; no crea tareas ni publica ni toca V1.",
  "steps": [
    {
      "kind": "powershell",
      "name": "diagnose-v2-top30-task",
      "script": "$o=@{diagnostic='v2_top30_schedule';state='checked';task_present=$false;task_state='';last_result=$null;last_run=$null;next_run=$null;local_runner=$false;local_tick=$false;gh_available=$false}\ntry {\n $t=Get-ScheduledTask -TaskName 'TTActualidadV2-Top30-15m' -ErrorAction SilentlyContinue\n if($t){$o.task_present=$true;$o.task_state=$t.State.ToString();$i=Get-ScheduledTaskInfo -TaskName 'TTActualidadV2-Top30-15m';$o.last_result=$i.LastTaskResult;$o.last_run=([string]$i.LastRunTime);$o.next_run=([string]$i.NextRunTime)}\n $root=Join-Path $env:LOCALAPPDATA 'TTActualidadV2'\n $o.local_runner=Test-Path (Join-Path $root 'Run-V2-Top30-Tick.ps1')\n $o.local_tick=Test-Path (Join-Path $root 'top30_tick_v2.py')\n $o.gh_available=!!(Get-Command gh.exe -ErrorAction SilentlyContinue)\n}catch{$o.state='failed';$o.error=$_.Exception.GetType().Name}\nWrite-Output ('TTRESULT:'+($o|ConvertTo-Json -Compress))",
      "timeout_seconds": 30
    }
  ]
}
