{
  "version": 1,
  "id": "ttb-news-compositor-result-20261112-1307",
  "project": "TTActualidad",
  "expires_at": "2026-11-13T12:00:00Z",
  "description": "Read safe state of one target editorial retry",
  "steps": [
    {
      "kind": "powershell",
      "name": "news-compositor-result",
      "script": "$l=@(Get-Content 'C:\\TTiTTulares\\ttittulares-mobile-trigger.log' -Tail 400)\n$id='tt-compositorfix-1794482043007'\n$o=@{state='pending';marker_count=@($l|Where-Object{$_ -match $id}).Count;guard_tag='unknown';draft_length=0}\nif(@($l|Where-Object{$_ -match ('LAUNCH CONFIRMED.*'+$id)}).Count){$o.state='confirmed'}\nif(@($l|Where-Object{$_ -match ('LAUNCH FAILED.*'+$id)}).Count){$o.state='failed'}\n$g=[string]($l|Where-Object{$_ -match 'NEW_CHAT_NOT_BLANK'}|Select-Object -Last 1)\nif($g -match 'editorLength[^0-9]*([0-9]+)'){$o.draft_length=[int]$Matches[1]}\nif($g -match 'editorTag[^a-zA-Z]*(TEXTAREA|DIV)'){$o.guard_tag=$Matches[1]}\nWrite-Output ('TTRESULT:'+($o|ConvertTo-Json -Compress))",
      "timeout_seconds": 20
    }
  ]
}
