{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttendencias-no-vercel-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "../ttendencias",
    "binding": "ASSETS"
  },
  "observability": { "enabled": false }
}
