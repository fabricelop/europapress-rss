{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTiTTulares V2 data contract bundle — validate a document against the matching $defs entry",
  "oneOf": [
    {
      "$ref": "#/$defs/news_event"
    },
    {
      "$ref": "#/$defs/queue_index"
    },
    {
      "$ref": "#/$defs/editorial_job"
    },
    {
      "$ref": "#/$defs/editorial_record"
    },
    {
      "$ref": "#/$defs/image_job"
    },
    {
      "$ref": "#/$defs/image_asset"
    },
    {
      "$ref": "#/$defs/decision_event"
    },
    {
      "$ref": "#/$defs/publication_receipt"
    }
  ],
  "$defs": {
    "event_id": {
      "type": "string",
      "pattern": "^ttn2-[a-f0-9]{24}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "news_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "event_id",
        "current_revision",
        "status",
        "identity",
        "source_summary",
        "revision_refs",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "current_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "monitoring",
            "eligible",
            "editorial_pending",
            "editorial_in_progress",
            "ready",
            "published",
            "dismissed",
            "deleted",
            "archived"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_fact",
            "canonical_title",
            "first_seen_at",
            "last_seen_at",
            "dedupe_keys"
          ],
          "properties": {
            "canonical_fact": {
              "type": "string",
              "minLength": 12
            },
            "canonical_title": {
              "type": "string",
              "minLength": 3
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "first_seen_at": {
              "$ref": "#/$defs/date_time"
            },
            "last_seen_at": {
              "$ref": "#/$defs/date_time"
            },
            "dedupe_keys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value_sha256"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "canonical_url",
                      "headline_fingerprint",
                      "fact_fingerprint",
                      "publisher_story_id"
                    ]
                  },
                  "value_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        "source_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "general_family_count",
            "general_family_threshold",
            "sport_source_count",
            "discovery_source_count"
          ],
          "properties": {
            "general_family_count": {
              "type": "integer",
              "minimum": 0
            },
            "general_family_threshold": {
              "type": "integer",
              "minimum": 1
            },
            "sport_source_count": {
              "type": "integer",
              "minimum": 0
            },
            "discovery_source_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "revision_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "reason",
              "status",
              "requested_at",
              "editorial_job_id"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "initial",
                  "material_update",
                  "user_rework",
                  "automatic_retry",
                  "factual_correction"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "ready",
                  "problematic",
                  "superseded",
                  "dismissed",
                  "published",
                  "deleted"
                ]
              },
              "requested_at": {
                "$ref": "#/$defs/date_time"
              },
              "editorial_job_id": {
                "type": "string"
              },
              "record_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "current_record_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v1_event_id": {
              "type": "string"
            },
            "migration_note": {
              "type": "string"
            }
          }
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    },
    "queue_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "queue_type",
        "updated_at",
        "source_of_truth",
        "pending_count",
        "active_count",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "queue_type": {
          "enum": [
            "editorial",
            "images"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        },
        "source_of_truth": {
          "const": "individual_job_files"
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job_id",
              "event_id",
              "revision",
              "status",
              "priority",
              "requested_at",
              "job_path"
            ],
            "properties": {
              "job_id": {
                "type": "string"
              },
              "event_id": {
                "$ref": "#/$defs/event_id"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "urgent",
                  "manual_rework",
                  "material_update",
                  "manual_submission",
                  "automatic"
                ]
              },
              "requested_at": {
                "$ref": "#/$defs/date_time"
              },
              "job_path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker_id",
            "token_sha256",
            "started_at",
            "heartbeat_at",
            "expires_at"
          ],
          "properties": {
            "worker_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "token_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "started_at": {
              "$ref": "#/$defs/date_time"
            },
            "heartbeat_at": {
              "$ref": "#/$defs/date_time"
            },
            "expires_at": {
              "$ref": "#/$defs/date_time"
            }
          }
        }
      ]
    },
    "send_intent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "prompt_sha256",
            "prepared_at",
            "submission_state",
            "attempt_no"
          ],
          "properties": {
            "command_id": {
              "type": "string"
            },
            "prompt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "prepared_at": {
              "$ref": "#/$defs/date_time"
            },
            "submitted_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "submission_state": {
              "enum": [
                "prepared",
                "submitted",
                "uncertain",
                "confirmed"
              ]
            },
            "attempt_no": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "session": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "conversation_url_sha256",
            "private_journal_id"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "target_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "conversation_url_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "private_journal_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_count",
        "safe_preflight_failures",
        "submission_count",
        "max_safe_preflight_attempts",
        "history"
      ],
      "properties": {
        "claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "safe_preflight_failures": {
          "type": "integer",
          "minimum": 0
        },
        "submission_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_safe_preflight_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_no",
              "command_id",
              "at",
              "outcome"
            ],
            "properties": {
              "attempt_no": {
                "type": "integer",
                "minimum": 1
              },
              "command_id": {
                "type": "string"
              },
              "at": {
                "$ref": "#/$defs/date_time"
              },
              "outcome": {
                "enum": [
                  "preflight_failed",
                  "submitted",
                  "uncertain",
                  "captured",
                  "failed_after_submit"
                ]
              }
            }
          }
        }
      }
    },
    "problem": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "at",
            "retry_mode"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/date_time"
            },
            "retry_mode": {
              "enum": [
                "safe_pre_submit",
                "new_chat",
                "recover_same_chat",
                "manual_only",
                "none"
              ]
            },
            "detail_safe": {
              "type": "string"
            }
          }
        }
      ]
    },
    "editorial_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "job_id",
        "event_id",
        "revision",
        "status",
        "phase",
        "priority",
        "requested_at",
        "updated_at",
        "prompt",
        "attempts",
        "lease",
        "send_intent",
        "session",
        "capture",
        "result",
        "problem"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "job_id": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "send_intent",
            "awaiting_response",
            "capture_recovery",
            "captured",
            "validating",
            "persisting",
            "ready",
            "problematic",
            "superseded",
            "cancelled"
          ]
        },
        "phase": {
          "enum": [
            "queued",
            "claiming",
            "browser_starting",
            "chat_starting",
            "sending",
            "awaiting_response",
            "capturing",
            "researching",
            "drafting",
            "remate_selection",
            "verifying",
            "persisting",
            "closing_browser",
            "done",
            "recovering",
            "blocked"
          ]
        },
        "priority": {
          "enum": [
            "urgent",
            "manual_rework",
            "material_update",
            "manual_submission",
            "automatic"
          ]
        },
        "requested_at": {
          "$ref": "#/$defs/date_time"
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        },
        "prompt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "template_version",
                "prompt_sha256"
              ],
              "properties": {
                "template_version": {
                  "type": "string"
                },
                "prompt_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "send_intent": {
          "$ref": "#/$defs/send_intent"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "capture": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answer_sha256",
                "captured_at",
                "complete",
                "local_journal_id"
              ],
              "properties": {
                "answer_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "captured_at": {
                  "$ref": "#/$defs/date_time"
                },
                "complete": {
                  "const": true
                },
                "local_journal_id": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_path",
                "record_sha256",
                "commit_sha"
              ],
              "properties": {
                "record_path": {
                  "type": "string"
                },
                "record_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              }
            }
          ]
        },
        "problem": {
          "$ref": "#/$defs/problem"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "capture": {
                "type": "object"
              },
              "result": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "send_intent",
                  "awaiting_response",
                  "captured",
                  "validating",
                  "persisting",
                  "ready"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "prompt": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "editorial_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "event_id",
        "revision",
        "record_status",
        "title",
        "canonical_url",
        "factual_summary",
        "explanation",
        "selection_mode",
        "source_count",
        "drafted_source_count",
        "verified_source_count",
        "source_evidence",
        "verification",
        "tweet",
        "editorial_job_id",
        "editorial_sha256",
        "prepared_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "record_status": {
          "const": "ready"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "factual_summary": {
          "type": "string",
          "minLength": 20
        },
        "explanation": {
          "type": "string",
          "minLength": 20
        },
        "selection_mode": {
          "enum": [
            "automatic",
            "manual_growing",
            "user_suggestion",
            "material_update",
            "user_rework"
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "drafted_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_name",
              "source_family",
              "source_type",
              "article_url",
              "source_title",
              "retrieved_at",
              "supports",
              "independent"
            ],
            "properties": {
              "source_name": {
                "type": "string"
              },
              "source_family": {
                "type": "string"
              },
              "source_type": {
                "enum": [
                  "general",
                  "sport",
                  "discovery",
                  "primary"
                ]
              },
              "article_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "source_title": {
                "type": "string"
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrieved_at": {
                "$ref": "#/$defs/date_time"
              },
              "supports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "independent": {
                "type": "boolean"
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "essential_fact_verified",
            "verified_at",
            "method",
            "unresolved_issues"
          ],
          "properties": {
            "essential_fact_verified": {
              "const": true
            },
            "verified_at": {
              "$ref": "#/$defs/date_time"
            },
            "method": {
              "enum": [
                "four_family_consensus",
                "primary_plus_independent",
                "two_independent_sources",
                "manual_exception_verified"
              ]
            },
            "unresolved_issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tweet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "remate",
            "hashtags",
            "character_count"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "remate": {
              "type": "string",
              "pattern": "^(?:🌶️ .+)?$"
            },
            "hashtags": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[^\\s#]+$"
              }
            },
            "character_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        },
        "no_remate_reason": {
          "type": "string"
        },
        "editorial_job_id": {
          "type": "string"
        },
        "editorial_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "radar_scan_id": {
          "type": "string"
        },
        "prepared_at": {
          "$ref": "#/$defs/date_time"
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v1_event_id": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tweet": {
                "properties": {
                  "remate": {
                    "const": ""
                  }
                }
              }
            },
            "required": [
              "tweet"
            ]
          },
          "then": {
            "required": [
              "no_remate_reason"
            ]
          }
        }
      ]
    },
    "image_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "job_id",
        "event_id",
        "revision",
        "status",
        "phase",
        "source_record_path",
        "editorial_sha256",
        "prompt_version",
        "prompt_sha256",
        "policy",
        "attempts",
        "lease",
        "send_intent",
        "session",
        "capture",
        "result",
        "problem",
        "requested_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "job_id": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "send_intent",
            "generating",
            "capture_recovery",
            "captured",
            "validating",
            "persisting",
            "saved",
            "problematic",
            "superseded",
            "cancelled"
          ]
        },
        "phase": {
          "enum": [
            "queued",
            "claiming",
            "browser_starting",
            "chat_starting",
            "sending",
            "generating",
            "capturing",
            "validating",
            "persisting",
            "closing_browser",
            "done",
            "recovering",
            "blocked"
          ]
        },
        "source_record_path": {
          "type": "string"
        },
        "editorial_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_version": {
          "type": "string"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "visual_treatment"
          ],
          "properties": {
            "mode": {
              "enum": [
                "automatic",
                "manual_request"
              ]
            },
            "visual_treatment": {
              "enum": [
                "editorial_gag",
                "serious_contextual"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "send_intent": {
          "$ref": "#/$defs/send_intent"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "capture": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raster_sha256",
                "captured_at",
                "mime",
                "width",
                "height",
                "bytes"
              ],
              "properties": {
                "raster_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "captured_at": {
                  "$ref": "#/$defs/date_time"
                },
                "mime": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                },
                "width": {
                  "type": "integer",
                  "minimum": 1024
                },
                "height": {
                  "type": "integer",
                  "minimum": 576
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 12000,
                  "maximum": 8388608
                }
              }
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_path",
                "media_id",
                "sha256",
                "commit_sha"
              ],
              "properties": {
                "asset_path": {
                  "type": "string"
                },
                "media_id": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              }
            }
          ]
        },
        "problem": {
          "$ref": "#/$defs/problem"
        },
        "requested_at": {
          "$ref": "#/$defs/date_time"
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "saved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "capture": {
                "type": "object"
              },
              "result": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "image_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "media_id",
        "event_id",
        "revision",
        "editorial_sha256",
        "image_job_id",
        "command_id",
        "sha256",
        "mime",
        "width",
        "height",
        "bytes",
        "asset_path",
        "origin",
        "verified",
        "created_at",
        "alt",
        "rights_status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "media_id": {
          "type": "string",
          "pattern": "^img2-[a-f0-9]{24}$"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "editorial_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "image_job_id": {
          "type": "string"
        },
        "command_id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 576
        },
        "bytes": {
          "type": "integer",
          "minimum": 12000,
          "maximum": 8388608
        },
        "asset_path": {
          "type": "string",
          "pattern": "^v2/ttittulares/images/"
        },
        "origin": {
          "const": "chatgpt_images"
        },
        "verified": {
          "const": true
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        },
        "alt": {
          "type": "string",
          "minLength": 3
        },
        "rights_status": {
          "const": "generated"
        }
      }
    },
    "decision_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "decision_id",
        "event_id",
        "revision",
        "action",
        "actor",
        "occurred_at",
        "idempotency_key"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^dcn2-[a-f0-9]{24}$"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "prioritize",
            "dismiss",
            "delete",
            "request_rework",
            "mark_published",
            "publish_request",
            "restore",
            "archive"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "occurred_at": {
          "$ref": "#/$defs/date_time"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8
        },
        "rework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "instructions"
          ],
          "properties": {
            "scope": {
              "enum": [
                "reinvestigate",
                "factual_correction",
                "text_rewrite",
                "remate_only"
              ]
            },
            "instructions": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform"
          ],
          "properties": {
            "platform": {
              "enum": [
                "x",
                "instagram"
              ]
            }
          }
        },
        "manual_publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "enum": [
                "x",
                "instagram"
              ]
            },
            "post_url": {
              "type": "string",
              "format": "uri"
            },
            "evidence_note": {
              "type": "string"
            }
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "request_rework"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "rework"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "publish_request"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "publication"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mark_published"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "manual_publication"
            ]
          }
        }
      ]
    },
    "publication_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "receipt_id",
        "event_id",
        "revision",
        "decision_id",
        "platform",
        "status",
        "requested_at",
        "updated_at",
        "attempt_no",
        "manual_confirmation"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "const": "ttittulares-v2"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^rcp2-[a-f0-9]{24}$"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision_id": {
          "type": "string",
          "pattern": "^dcn2-[a-f0-9]{24}$"
        },
        "platform": {
          "enum": [
            "x",
            "instagram"
          ]
        },
        "status": {
          "enum": [
            "requested",
            "submitting",
            "confirmed",
            "failed",
            "uncertain",
            "cancelled"
          ]
        },
        "requested_at": {
          "$ref": "#/$defs/date_time"
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_post_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "manual_confirmation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmed_at"
            ],
            "anyOf": [
              {
                "required": [
                  "external_post_id"
                ],
                "properties": {
                  "external_post_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "manual_confirmation"
                ],
                "properties": {
                  "manual_confirmation": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
