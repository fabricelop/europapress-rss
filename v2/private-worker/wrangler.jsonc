{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttactualidad-v2-private-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SESSION_HOURS": "12",
    "REELABORATION_ENABLED": "NO"
  }
}
