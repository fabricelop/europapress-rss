{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttactualidad-v2-private-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SESSION_HOURS": "720",
    "REELABORATION_ENABLED": "NO"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2611149301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "MARKS_DB",
      "database_name": "ttactualidad-v2-marks",
      "database_id": "bc11570d-5f1e-40cc-9692-861e7103eca2"
    }
  ]
}
