{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttactualidad-v2-private-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SESSION_HOURS": "720",
    "REELABORATION_ENABLED": "NO"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2611149301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
