{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram-webhook.js": {
      "maxDuration": 10
    },
    "api/ttendencias-control.js": {
      "maxDuration": 10
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/ttendencias",
      "destination": "/ttendencias/index.html"
    }
  ]
}
