tons":[{"label":"Preparar N1","callback_data":"prepare:N1"}],"search_terms":["Moreno","117 capellanes","Andalucía"]},{"text":"🗂️ N2. El aeropuerto de Vilna cierra temporalmente tras detectar un dron procedente de Bielorrusia.","buttons":[{"label":"Preparar N2","callback_data":"prepare:N2"}],"search_terms":["Vilna","Bielorrusia","dron"]},{"text":"🗂️ N3. El Gobierno de Ceuta solicita el desalojo urgente del asentamiento levantado junto a la desalinizadora.","buttons":[{"label":"Preparar N3","callback_data":"prepare:N3"}],"search_terms":["Ceuta","desalinizadora"]},{"text":"🗂️ N4. El PSdeG califica de «patriotismo de pacotilla» la postura del PP sobre los menores migrantes en Ceuta.","buttons":[{"label":"Preparar N4","callback_data":"prepare:N4"}],"search_terms":["PSdeG","PP","Ceuta"]},{"text":"🗂️ N5. Asturias convocará una reunión extraordinaria contra la LGTBIfobia tras la agresión de San Mateo.","buttons":[{"label":"Preparar N5","callback_data":"prepare:N5"}],"search_terms":["Asturias","LGTBIfobia","San Mateo"]},{"text":"🗂️ N6. Piden 12 años de prisión para un acusado de secuestrar y maltratar a su pareja con ayuda de su madre en Mallorca.","buttons":[{"label":"Preparar N6","callback_data":"prepare:N6"}],"search_terms":["Mallorca","secuestro","maltrato"]},{"text":"🗂️ N7. Isabel López logra el oro y Juan Antonio Saavedra el bronce en el Mundial de tiro paralímpico.","buttons":[{"label":"Preparar N7","callback_data":"prepare:N7"}],"search_terms":["Isabel López","Saavedra","tiro paralímpico"]},{"text":"🗂️ N8. Coria reparte pulseras de detección de drogas durante su feria para reforzar la seguridad de las mujeres.","buttons":[{"label":"Preparar N8","callback_data":"prepare:N8"}],"search_terms":["Coria","pulseras","drogas"]},{"text":"🗂️ N9. Más de 20 supuestos miembros de Estado Islámico son detenidos en una operación en el norte de Irak.","buttons":[{"label":"Preparar N9","callback_data":"prepare:N9"}],"search_terms":["Estado Islámico","Irak"]},{"text":"🗂️ N10. La Diputación de Jaén denuncia falta de medios de la Junta en el incendio del Cerro del Cuco, en Jódar.","buttons":[{"label":"Preparar N10","callback_data":"prepare:N10"}],"search_terms":["Jódar","incendio","Junta"]}]}