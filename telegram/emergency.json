        [
          {
            "text": "PUBLICAR A",
            "url": "https://twitter.com/intent/tweet?text=El%20Legan%C3%A9s%20gana%203-2%20al%20Granada%20con%20un%20gol%20de%20Gharbi%20en%20el%2090%20despu%C3%A9s%20de%20que%20los%20nazar%C3%ADes%20levantaran%20un%202-0.%20%F0%9F%8C%B6%EF%B8%8F%20El%20Granada%20remont%C3%B3%20un%202-0%20para%20descubrir%20que%20el%20minuto%2090%20tambi%C3%A9n%20juega."
