        [
          {
            "text": "PUBLICAR ORIGINAL",
            "url": "https://twitter.com/intent/tweet?text=El%20Gobierno%20prev%C3%A9%20que%20la%20mayor%C3%ADa%20de%20los%20menores%20no%20acompa%C3%B1ados%20llegados%20a%20Ceuta%20permanezcan%20en%20Espa%C3%B1a%3B%20la%20ministra%20Sira%20Rego%20afirma%20que%20quieren%20quedarse%20y%20que%20la%20ley%20los%20protege."
