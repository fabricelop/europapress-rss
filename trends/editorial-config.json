{
  "project": "TTendencias",
  "editorial": {
    "alternatives_target": 0,
    "alternatives_block_send": false,
    "images_enabled_in_web_control": false,
    "schedule_minutes": [
      15
    ],
    "daytime_max_wait_minutes": 30,
    "schedule_timezone": "Europe/Madrid",
    "detection_schedule_minutes": [
      7,
      17,
      27,
      37,
      47,
      57
    ],
    "auto_queue_new_trends": true,
    "delay_warning_after_minutes": 30,
    "problematic_only_on_editorial_failure": true,
    "image_policy": {
      "enabled": false,
      "mode": "disabled",
      "always_generate": false,
      "display_in_web_control": false,
      "queue_instruction": "TTendencias no genera imágenes. Investiga y guarda únicamente una explicación factual y clasifica si existe una noticia para TTiTTulares.",
      "note": "Toda redacción final e imagen de noticias derivadas pertenece exclusivamente a TTiTTulares."
    },
    "queue_consumer_only": true,
    "queue_states": [
      "preparing",
      "update",
      "problematic"
    ],
    "output_file": "trends/telegram-manual-explained.json",
    "ready_after_persist": false,
    "api_failover": {
      "enabled": false,
      "grace_minutes": 8,
      "model": "gpt-5.6"
    },
    "early_trend_radar": {
      "enabled": true,
      "social_rank_window": [
        11,
        20
      ],
      "min_social_sources": 2,
      "accept_one_social_source_when_ttittulares_sources_at_least": 4,
      "max_candidates": 8,
      "use_ttittulares": true,
      "auto_queue_for_editorial": false,
      "track_first_detection": true,
      "track_entry_into_top10": true,
      "note": "Radar informativo: muestra señales observadas, no una probabilidad."
    },
    "mode": "explanation_only",
    "explanation_only": true,
    "news_bridge": {
      "enabled": true,
      "candidate_file": "ttittulares/trend-candidates.json",
      "direct_processing_file": "telegram/editorial-processing.json",
      "rules": {
        "direct_to_processing": "Acontecimiento concreto, reciente, no duplicado y verificado por al menos 2 fuentes fiables independientes.",
        "to_trends": "Hay indicios razonables de noticia, pero falta contexto o verificación suficiente para enviarla directamente a elaboración.",
        "ignore": "Conversación genérica, programa/hashtag sin hecho nuevo, fandom, meme, promoción, tendencia ambigua o duplicado."
      }
    }
  },
  "delivery": {
    "channel": "web",
    "telegram_is_control_surface": false
  },
  "notifications": {
    "channel": "app",
    "badge_enabled": true,
    "telegram_enabled": false
  }
}
