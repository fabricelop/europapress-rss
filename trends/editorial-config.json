{
  "project": "TTendencias",
  "editorial": {
    "alternatives_target": 3,
    "alternatives_block_send": false,
    "images_enabled_in_web_control": false,
    "schedule_minutes": [
      10,
      40
    ],
    "daytime_max_wait_minutes": 30,
    "schedule_timezone": "Europe/Madrid",
    "detection_schedule_minutes": [
      5,
      20,
      35,
      50
    ],
    "auto_queue_new_trends": true,
    "delay_warning_after_minutes": 30,
    "problematic_only_on_editorial_failure": true,
    "image_policy": {
      "enabled": false,
      "format": "1:1",
      "generate_when_candidate": true,
      "non_blocking": true,
      "prompt_basis": "factual_explanation_plus_blended_tone_of_all_remates",
      "skip_if_forced_or_sensitive": true,
      "storage": "vercel_blob",
      "delete_on_explained_or_dismissed": true
    },
    "queue_consumer_only": true,
    "queue_states": [
      "preparing",
      "update"
    ],
    "output_file": "trends/prepared.json",
    "ready_after_persist": true,
    "api_failover": {
      "enabled": true,
      "grace_minutes": 8,
      "model": "gpt-5.6"
    }
  },
  "delivery": {
    "channel": "web",
    "telegram_is_control_surface": false
  },
  "notifications": {
    "channel": "app",
    "badge_enabled": true,
    "telegram_enabled": false
  }
}
