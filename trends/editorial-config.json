{
  "project": "TTendencias",
  "editorial": {
    "alternatives_target": 3,
    "alternatives_block_send": false,
    "images_enabled_in_web_control": true,
    "schedule_minutes": [
      0,
      30
    ],
    "daytime_max_wait_minutes": 30,
    "schedule_timezone": "Europe/Madrid",
    "detection_schedule_minutes": [
      7,
      17,
      27,
      37,
      47,
      57
    ],
    "auto_queue_new_trends": true,
    "delay_warning_after_minutes": 30,
    "problematic_only_on_editorial_failure": true,
    "image_policy": {
      "enabled": true,
      "mode": "existing_web_image",
      "generate_when_candidate": false,
      "non_blocking": true,
      "source_preference": [
        "official_or_primary",
        "reputable_media"
      ],
      "require_source_page": true,
      "display_in_web_control": "links",
      "store": "external_url_only",
      "rights_status_default": "unverified",
      "output_schema": {
        "image": {
          "url": "direct_image_url",
          "source": "publisher_or_owner",
          "source_url": "page_where_image_appears",
          "rights_status": "reusable|official|unverified",
          "alt": "short_description"
        }
      },
      "rule": "Cuando with_image=true la búsqueda es obligatoria: hacer al menos una búsqueda específica de imágenes y, si no sale una URL directa útil, una segunda vía (otra fuente o og:image/social image). Priorizar fuente oficial/primaria y después medios fiables. Una imagen pertinente de un medio fiable es válida como sugerencia aunque la licencia no esté verificada; marcar rights_status=unverified. Solo omitir si tras esos intentos no hay imagen real pertinente."
    },
    "queue_consumer_only": true,
    "queue_states": [
      "preparing",
      "update"
    ],
    "output_file": "trends/prepared.json",
    "ready_after_persist": true,
    "api_failover": {
      "enabled": false,
      "grace_minutes": 8,
      "model": "gpt-5.6"
    },
    "early_trend_radar": {
      "enabled": true,
      "social_rank_window": [
        11,
        20
      ],
      "min_social_sources": 2,
      "accept_one_social_source_when_ttittulares_sources_at_least": 4,
      "max_candidates": 8,
      "use_ttittulares": true,
      "auto_queue_for_editorial": false,
      "track_first_detection": true,
      "track_entry_into_top10": true,
      "note": "Radar informativo: muestra señales observadas, no una probabilidad."
    }
  },
  "delivery": {
    "channel": "web",
    "telegram_is_control_surface": false
  },
  "notifications": {
    "channel": "app",
    "badge_enabled": true,
    "telegram_enabled": false
  }
}
