        "https://www.huffingtonpost.es/virales/detienen-instagramer-paracetamol-difundir-mensajes-odio-canciones-f202610.html"
      ],
      "source_evidence": [
        {
          "url": "https://www.heraldo.es/noticias/aragon/zaragoza/2026/10/26/policia-detiene-zaragoza-paracetamol-instagramer-buscado-por-camuflar-sus-canciones-mensajes-odio-2062977.html",
