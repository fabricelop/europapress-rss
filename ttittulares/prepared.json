      "drafted_source_count": 2,
      "verified_source_count": 2,
      "source_count": 4,
      "tweet": {
        "text": "Eric Bauza, voz moderna de Bugs Bunny y el Pato Lucas, murió el domingo a los 46 años. El forense de Los Ángeles atribuye la muerte a una enfermedad cardiovascular hipertensiva.\n\n#EricBauza #LooneyTunes\n🌶️ Aquí no toca chiste.",
        "remate": "🌶️ Aquí no toca chiste.",
        "url": "https://twitter.com/intent/tweet?text=Eric%20Bauza%2C%20voz%20moderna%20de%20Bugs%20Bunny%20y%20el%20Pato%20Lucas%2C%20muri%C3%B3%20el%20domingo%20a%20los%2046%20a%C3%B1os.%20El%20forense%20de%20Los%20%C3%81ngeles%20atribuye%20la%20muerte%20a%20una%20enfermedad%20cardiovascular%20hipertensiva.%0A%0A%23EricBauza%20%23LooneyTunes%0A%F0%9F%8C%B6%EF%B8%8F%20Aqu%C3%AD%20no%20toca%20chiste."
