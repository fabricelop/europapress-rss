      "drafted_source_count": 3,
      "verified_source_count": 3,
      "source_count": 3,
      "sources_at_draft": [
        "Europa Press",
        "Cadena SER",
        "EFE"
      ],
      "factual_summary": "El PP convocó para las 10:00 de este lunes una declaración institucional de Alberto Núñez Feijóo en su sede nacional de la calle Génova para valorar el adelanto de las elecciones generales al 29 de noviembre anunciado una hora antes por Pedro Sánchez. Europa Press, Cadena SER y una información de EFE coinciden en la convocatoria y el motivo de la comparecencia.",
      "source_evidence": [
        {
          "source": "Europa Press",
          "source_type": "general",
          "title": "Feijóo comparecerá hoy a las 10:00 en la sede del PP tras el anuncio de adelanto electoral de Pedro Sánchez",
          "url": "https://www.europapress.es/nacional/noticia-feijoo-comparecera-hoy-1000-sede-pp-anuncio-adelanto-electoral-pedro-sanchez-20261005092432.html",
          "source_family": "Europa Press"
        },
        {
          "source": "Cadena SER",
          "source_type": "general",
          "title": "Feijóo comparece a las 10:00 horas tras el adelanto de las elecciones al 29 de noviembre",
          "url": "https://cadenaser.com/nacional/2026/10/05/feijoo-comparece-a-las-1000-horas-tras-el-adelanto-de-las-elecciones-al-29-de-noviembre-cadena-ser/",
