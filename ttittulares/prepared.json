      "drafted_source_count": 3,
      "verified_source_count": 3,
      "source_count": 3,
      "sources_at_draft": [
        "Europa Press",
        "laSexta",
        "FIFA"
      ],
      "factual_summary": "Leo Messi se despidió de la selección argentina después de disputar ante Benín su último partido con la Albiceleste. En un mensaje en Instagram publicado al día siguiente afirmó que ya extraña vestir la celeste y blanca y que considera correcta su decisión de dejar la selección.",
      "source_evidence": [
        {
          "source": "Europa Press",
          "source_type": "general",
          "title": "Messi: \"Ya extraño vestir la celeste y blanca\"",
          "url": "https://www.europapress.es/deportes/futbol-00162/noticia-messi-ya-extrano-vestir-celeste-blanca-20261007204340.html",
          "source_family": "Europa Press"
        },
        {
          "source": "laSexta",
          "source_type": "general",
          "title": "El último mensaje de Leo Messi para la selección argentina",
          "url": "https://www.lasexta.com/noticias/deportes/futbol/ultimo-mensaje-leo-messi-seleccion-argentina-extrano-vestir-celeste-blanca_202610076ac68bd11032db2258700f13.html",
          "source_family": "laSexta"
        },
        {
          "source": "FIFA",
          "source_type": "official",
          "title": "Messi: Juro que daría todo para jugar toda la vida en la Selección argentina",
          "url": "https://www.fifa.com/es/tournaments/mens/worldcup/articles/messi-juro-que-daria-todo-para-jugar-toda-la-vida-en-la-seleccion-argentina",
          "source_family": "FIFA"
        }
      ],
      "tweet": {
        "text": "Leo Messi se despidió de Argentina tras su último partido ante Benín. En Instagram dijo que ya extraña la celeste y blanca y que cree haber tomado la decisión correcta.\n\n🌶️ La camiseta 10 se ha retirado antes que la nostalgia.",
        "remate": "🌶️ La camiseta 10 se ha retirado antes que la nostalgia.",
