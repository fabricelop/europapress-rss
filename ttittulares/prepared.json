        {
          "source": "Reuters",
          "source_type": "general",
          "title": "Brazil markets set to rally after Bolsonaro leads first-round vote",
          "url": "https://www.reuters.com/world/americas/brazil-markets-set-rally-bolsonaro-leads-first-round-vote-2026-10-05/",
          "note": "Sitúa a Flávio Bolsonaro en torno al 47% y a Lula en torno al 45%, con segunda vuelta el 25 de octubre."
        },
        {
          "source": "AP",
          "source_type": "general",
          "title": "Flávio Bolsonaro and Lula da Silva advance to Brazil runoff",
          "url": "https://apnews.com/article/53b7f13ea226017fd62c7edbd6af5892",
          "note": "Confirma que ambos pasan a segunda vuelta tras una primera vuelta sin mayoría absoluta."
        },
        {
          "source": "Cadena SER",
          "source_type": "general",
          "title": "Flávio Bolsonaro, hijo del exlíder ultra, gana las elecciones a Lula y se disputarán la Presidencia de Brasil el 25 de octubre",
