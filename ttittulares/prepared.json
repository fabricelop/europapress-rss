      "revision": 1,
      "title": "El exconseller Lluís Puig vuelve a casa tras nueve años",
      "url": "https://www.eldiario.es/catalunya/exconseller-lluis-puig-vuelve-casa-nueve-anos-hoy-perdido-judicatura-espanola-quiere-politica_1_13604853.html",
      "selection_mode": "AUTO_WEB",
      "factual_summary": "Lluís Puig regresó a Cataluña tras nueve años en Bélgica y este jueves acudió al Parlament para retomar su actividad presencial como diputado de Junts después de que se levantara la orden de detención.",
      "explanation": "RTVE informó del regreso de Puig a España tras la anulación de las órdenes de detención y Europa Press confirmó su llegada este jueves al Parlament, donde fue recibido por Josep Rull antes de reincorporarse presencialmente al escaño.",
      "sources_at_draft": [
        "RTVE",
        "Europa Press"
      ],
      "drafted_source_count": 2,
      "source_count": 5,
      "verified_source_count": 2,
      "citations": [
        {
          "source": "RTVE",
          "url": "https://www.rtve.es/noticias/20261021/lluis-puig-espana-supremo-anulara-ordenes-detencion-amnistia/17276010.shtml"
        },
        {
          "source": "Europa Press",
          "url": "https://www.europapress.es/catalunya/noticia-rull-recibe-lluis-puig-junts-puertas-parlament-anos-20261022151421.html"
        }
