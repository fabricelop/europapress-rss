      "title": "Ana Orantes o Maricarmen: hay historias personales que despiertan la conciencia de un país",
      "url": "https://www.eldiario.es/sociedad/ana-orantes-maricarmen-hay-historias-personales-despiertan-conciencia-pais_129_13572045.html",
      "prepared_at": "2026-10-09T04:06:00.000Z",
      "drafted_source_count": 5,
      "verified_source_count": 4,
