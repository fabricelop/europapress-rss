          "source_family": "elDiario.es"
        },
        {
          "source": "Reuters",
          "source_type": "agency",
          "title": "Thousands of Spaniards march to mark death of octogenarian at heart of housing protests",
          "url": "https://www.reuters.com/world/europe/spanish-politicians-trade-blame-after-death-octogenarian-heart-housing-protests-2026-10-08/",
          "source_family": "Reuters"
        },
        {
          "source": "Telecinco Noticias",
