      "title": "Tres manifestantes de una concentración ultra, detenidos al intentar llegar a la acampada de Sol",
      "url": "https://www.europapress.es/sociedad/noticia-detenidos-tres-manifestantes-concentracion-indignados-espana-intentar-alcanzar-acampada-sol-20261003221022.html",
      "drafted_source_count": 3,
      "sources_at_draft": [
        "Europa Press",
        "RTVE",
        "EL PAÍS"
      ],
      "prepared_at": "2026-10-03T21:53:00Z",
