      ],
      "source_evidence": [
        {
          "source": "Europa Press",
          "source_family": "Europa Press",
          "url": "https://www.europapress.es/catalunya/noticia-absueltos-exconsellers-argimon-verges-retraso-vacunacion-policias-20261005160326.html"
