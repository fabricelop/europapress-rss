      ],
      "tweet": {
        "text": "elDiario.es analiza cómo Maricarmen y Ana Orantes se convirtieron, en épocas y causas distintas, en símbolos que aceleraron debates sobre vivienda y violencia machista.\n\n🌶️ A veces el país tarda un nombre propio en mirar de frente un problema viejo.",
        "remate": "🌶️ A veces el país tarda un nombre propio en mirar de frente un problema viejo.",
        "url": "https://twitter.com/intent/tweet?text=elDiario.es%20analiza%20c%C3%B3mo%20Maricarmen%20y%20Ana%20Orantes%20se%20convirtieron%2C%20en%20%C3%A9pocas%20y%20causas%20distintas%2C%20en%20s%C3%ADmbolos%20que%20aceleraron%20debates%20sobre%20vivienda%20y%20violencia%20machista.%0A%0A%F0%9F%8C%B6%EF%B8%8F%20A%20veces%20el%20pa%C3%ADs%20tarda%20un%20nombre%20propio%20en%20mirar%20de%20frente%20un%20problema%20viejo."
