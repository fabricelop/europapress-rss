{
  "project": "TTiTTulares",
  "radar": {
    "minimum_sources": 4,
    "waiting_ttl_hours": 24,
    "schedule_minutes": [
      10,
      40
    ],
    "timezone": "Europe/Madrid",
    "source_repair": "inline_parallel_fallback"
  },
  "editorial": {
    "schedule_minutes": [
      0,
      30
    ],
    "timezone": "Europe/Madrid",
    "tweets_per_story": 1,
    "verify_before_draft": true
  },
  "updates": {
    "material_change_creates_new_story": true,
    "reopen_previous_story": false
  },
  "display": {
    "sort_ready_by": "current_source_count_desc_then_prepared_at_desc",
    "show_current_sources": true,
    "show_source_health": true,
    "source_label_format": "Redactada con {drafted} ({current})"
  },
  "delivery": {
    "channel": "web",
    "enabled": true,
    "telegram_enabled_until_cutover": false,
    "parallel_new_items_only": false
  },
  "images": {
    "enabled": true,
    "mode": "ai_plus_fallback",
    "generate": true,
    "ai_attempts_initial": 1,
    "non_blocking": true,
    "fallback_enabled": true,
    "source_preference": [
      "official_or_primary",
      "reputable_media"
    ],
    "require_source_page": true,
    "store": "generated_repo_plus_external_fallback",
    "rights_status_default": "unverified",
    "explicit_not_found": true,
    "validate_https": true,
    "policy": "Intentar una sola imagen IA por noticia apta en estilo TT_STYLE_A_V1, siempre acorde con el resumen factual. Sensibles: disable_ai_image + fallback_only. Imagen, fallback, timeout o fallo nunca bloquean READY, Listas ni la cola.",
    "style_id": "TT_STYLE_A_V1",
    "style": "Caricatura satírica editorial muy expresiva y exagerada: un solo gag visual fuerte, entendido de un vistazo, colores vivos, props absurdos y situación llevada al límite; evitar imagen neutra o meramente literal.",
    "sensitive_mode": "fallback_only",
    "sensitive_sets_disable_ai_image": true,
    "max_visual_seconds": 120
  }
}
